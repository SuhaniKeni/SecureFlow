# =====================================================================
# SecureFlow: Environment Configuration Template (.env.example)
# =====================================================================

# System & Environment Settings
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# FastAPI Server Settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# Database Connection (SQLite Default / PostgreSQL Compatible)
DATABASE_URL=sqlite:///./data/secureflow.db

# Machine Learning Model Storage Path
MODEL_DIR=secureflow/models

# Optional LLM Explanation Provider Settings (Dual-Mode Fallback Enabled)
LLM_PROVIDER=none
LLM_API_KEY=
